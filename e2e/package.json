{
  "name": "testes-automatizados-e2e",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --project=login --project=ltcat --project=pgr --project=profissional",
    "test:e2e:login": "playwright test --project=login",
    "test:e2e:ltcat": "playwright test --project=ltcat",
    "test:e2e:ltcat-permissoes": "playwright test --project=ltcat-permissoes --workers=4",
    "test:e2e:ltcat-config-geral": "playwright test --project=ltcat-config-geral --no-deps --workers=1",
    "test:e2e:tudo": "playwright test --project=ltcat-config-geral --workers=1",
    "test:e2e:pgr": "playwright test --project=pgr",
    "test:e2e:profissional": "playwright test --project=profissional",
    "test:e2e:modelos-de-documento": "playwright test --project=modelos-de-documento",
    "test:e2e:perfis-de-acesso": "playwright test --project=perfis-de-acesso",
    "test:e2e:scripts": "playwright test --project=scripts --reporter=list",
    "test:e2e:carga": "playwright test --project=scripts --reporter=list scripts/carga/",
    "test:e2e:ferramentas": "playwright test --project=scripts --reporter=list scripts/ferramentas/",
    "test:e2e:explorar": "playwright test --project=scripts --reporter=list scripts/explorar/",
    "test:e2e:headed": "playwright test --project=login --project=ltcat --project=pgr --project=profissional --headed",
    "test:e2e:debug": "playwright test --project=login --project=ltcat --project=pgr --project=profissional --debug",
    "test:e2e:ui": "playwright test --project=login --project=ltcat --project=pgr --project=profissional --ui",
    "test:e2e:video": "playwright test -c playwright.video.config.ts --project=ltcat-permissoes --no-deps --reporter=list",
    "test:e2e:apresentacao": "playwright test -c playwright.apresentacao.config.ts specs/seguranca/programas-e-laudos/ltcat/anexos",
    "test:e2e:apresentacao:abrir": "playwright show-report apresentacao/relatorio",
    "test:e2e:report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@types/node": "^20.14.0",
    "dotenv": "^16.5.0",
    "typescript": "^5.5.0",
    "vitest": "^2.1.0"
  }
}
