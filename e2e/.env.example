# Origem (domínio) do sistema PGR, sem caminho — ex: https://apollus.dev.apollusehs.com.br
# O caminho da tela de login (/apollus/login) já está fixo em support/login.ts
PGR_URL=
# Usuário de teste (crie um usuário dedicado a testes, não use o seu pessoal)
PGR_USUARIO=
# Senha do usuário de teste
PGR_SENHA=
# Usuário dos testes de permissão: o PGR_USUARIO acima edita o perfil de acesso dele e este usuário é quem entra e é verificado
PGR_USUARIO_PERFIL=
PGR_SENHA_PERFIL=
# Senha de cada usuário de teste QAutomatizador_*: PGR_SENHA_<login> (logins em support/usuarios.ts).
# Use aspas simples, as senhas têm # e $
PGR_SENHA_QAUTO01=
PGR_SENHA_QAUTO02=
PGR_SENHA_QAUTO03=
PGR_SENHA_QAUTO04=
PGR_SENHA_QAUTO05=
PGR_SENHA_QAUTO06=
PGR_SENHA_QAUTO07=
PGR_SENHA_QAUTO08=
PGR_SENHA_QAUTO09=
PGR_SENHA_QAUTO10=
PGR_SENHA_QAUTO11=
PGR_SENHA_QAUTH01=
# Senha do certificado digital usada para assinar laudos (PGR e LTCAT)
PGR_SENHA_ASSINATURA=
