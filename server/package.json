{
  "name": "testes-automatizados-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --config=src/app/playwright.config.ts --project=login --project=ltcat --project=pgr --project=profissional",
    "test:e2e:login": "playwright test --config=src/app/playwright.config.ts --project=login",
    "test:e2e:ltcat": "playwright test --config=src/app/playwright.config.ts --project=ltcat",
    "test:e2e:pgr": "playwright test --config=src/app/playwright.config.ts --project=pgr",
    "test:e2e:profissional": "playwright test --config=src/app/playwright.config.ts --project=profissional",
    "test:e2e:modelos-de-documento": "playwright test --config=src/app/playwright.config.ts --project=modelos-de-documento",
    "test:e2e:perfis-de-acesso": "playwright test --config=src/app/playwright.config.ts --project=perfis-de-acesso",
    "test:e2e:scripts": "playwright test --config=src/app/playwright.config.ts --project=scripts --reporter=list",
    "test:e2e:headed": "playwright test --config=src/app/playwright.config.ts --project=login --project=ltcat --project=pgr --project=profissional --headed",
    "test:e2e:debug": "playwright test --config=src/app/playwright.config.ts --project=login --project=ltcat --project=pgr --project=profissional --debug",
    "test:e2e:ui": "playwright test --config=src/app/playwright.config.ts --project=login --project=ltcat --project=pgr --project=profissional --ui",
    "test:e2e:report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@types/node": "^20.14.0",
    "dotenv": "^16.5.0",
    "typescript": "^5.5.0",
    "vitest": "^2.1.0"
  }
}
